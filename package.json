{
  "name": "cliplayer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "icons": "node scripts/generate-icons.mjs",
    "dev": "vite --host 0.0.0.0",
    "api:dev": "tsx apps/api/src/index.ts",
    "build": "tsc --noEmit && vite build && npm run build:content",
    "build:content": "esbuild src/extension/content/index.ts --bundle --format=iife --platform=browser --target=chrome114 --outfile=dist/assets/content.js",
    "package:chrome": "npm run icons && npm run build && mkdir -p release && cd dist && python3 -m zipfile -c ../release/ClipLayer-0.1.0.zip .",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.8",
    "@vitejs/plugin-react": "^5.0.0",
    "dexie": "^4.0.11",
    "hono": "^4.7.0",
    "lucide-react": "^0.468.0",
    "nanoid": "^5.0.9",
    "vite": "^6.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2"
  }
}
